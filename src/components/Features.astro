---
// "How it works": four plain facts, no icons.
import { fmt, getDict } from '../i18n';
import type { Locale } from '../i18n/locales';

const dict = getDict(Astro.props.locale as Locale);
---

<section class="section split">
  <h2>{fmt(dict.why.title)}</h2>
  <ul class="facts-grid">
    {
      dict.why.items.map((item) => (
        <li>
          <h3>{item.title}</h3>
          <p>{item.text}</p>
        </li>
      ))
    }
  </ul>
</section>
