---
// Brand mark: a page being squeezed between two arrows.
const { size = 28 } = Astro.props;
---

<svg width={size} height={size} viewBox="0 0 32 32" aria-hidden="true" focusable="false">
  <rect width="32" height="32" rx="8" fill="var(--primary)"></rect>
  <path d="M11 8h7l4 4v12H11z" fill="#fff" opacity=".95"></path>
  <path d="M18 8v4h4" fill="none" stroke="var(--primary)" stroke-width="1.5"></path>
  <path d="M5 16h4m-2-2 2 2-2 2M27 16h-4m2-2-2 2 2 2" fill="none" stroke="#fff" stroke-width="1.6" stroke-linecap="round" stroke-linejoin="round"></path>
</svg>
