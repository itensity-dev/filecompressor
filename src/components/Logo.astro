---
// Brand mark: a frame with an arrow folding a big file into a small one.
const { size = 26 } = Astro.props;
---

<svg width={size} height={size} viewBox="0 0 32 32" aria-hidden="true" focusable="false">
  <rect x="1.5" y="1.5" width="29" height="29" rx="5" fill="none" stroke="currentColor" stroke-width="3"></rect>
  <rect x="7" y="15" width="10" height="10" rx="1.5" fill="var(--accent)"></rect>
  <path d="M25 7l-7 7m0-5v5h5" fill="none" stroke="currentColor" stroke-width="3" stroke-linecap="round" stroke-linejoin="round"></path>
</svg>
