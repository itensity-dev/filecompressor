---
import { getDict, toolText } from '../i18n';
import { LOCALE_INFO, LOCALES, localePath, type Locale } from '../i18n/locales';
import { SITE_NAME } from '../site';
import { TOOLS } from '../tools';
import Logo from './Logo.astro';

interface Props {
  locale: Locale;
  page: string;
}
const { locale, page } = Astro.props;
const dict = getDict(locale);
const groups = [
  { label: dict.nav.compress, tools: TOOLS.filter((t) => t.category === 'compress') },
  { label: dict.nav.convert, tools: TOOLS.filter((t) => t.category === 'convert') },
];
---

<header class="site-header">
  <div class="container header-inner">
    <a class="logo" href={localePath(locale)}>
      <Logo />
      <span>{SITE_NAME}</span>
    </a>
    <nav class="main-nav" aria-label={dict.nav.allTools}>
      {
        groups.map((g) => (
          <details class="menu">
            <summary>{g.label}</summary>
            <ul class="menu-list">
              {g.tools.map((tool) => (
                <li>
                  <a
                    href={localePath(locale, tool.id)}
                    aria-current={tool.id === page ? 'page' : undefined}
                  >
                    {toolText(dict, tool).name}
                  </a>
                </li>
              ))}
            </ul>
          </details>
        ))
      }
      <a class="nav-link hide-sm" href={localePath(locale, 'about')}>{dict.nav.about}</a>
      <details class="menu menu-lang">
        <summary aria-label={dict.nav.language}>
          <svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" aria-hidden="true"><circle cx="12" cy="12" r="9"></circle><path d="M3 12h18M12 3a14 14 0 0 1 0 18M12 3a14 14 0 0 0 0 18"></path></svg>
          <span class="hide-sm">{LOCALE_INFO[locale].name}</span>
        </summary>
        <ul class="menu-list menu-right">
          {
            LOCALES.map((l) => (
              <li>
                <a
                  href={localePath(l, page)}
                  hreflang={LOCALE_INFO[l].hreflang}
                  lang={LOCALE_INFO[l].hreflang}
                  aria-current={l === locale ? 'true' : undefined}
                  data-lang-choice
                >
                  {LOCALE_INFO[l].name}
                </a>
              </li>
            ))
          }
        </ul>
      </details>
    </nav>
  </div>
</header>

<script>
  // Close dropdowns on outside click / Escape, and keep only one open.
  const menus = Array.from(document.querySelectorAll<HTMLDetailsElement>('details.menu'));
  document.addEventListener('click', (e) => {
    for (const m of menus) if (m.open && !m.contains(e.target as Node)) m.open = false;
  });
  document.addEventListener('keydown', (e) => {
    if (e.key === 'Escape') for (const m of menus) m.open = false;
  });
  for (const m of menus) {
    m.addEventListener('toggle', () => {
      if (m.open) for (const o of menus) if (o !== m) o.open = false;
    });
  }
  for (const a of document.querySelectorAll('[data-lang-choice]')) {
    a.addEventListener('click', () => {
      try {
        localStorage.setItem('fc:lang-chosen', '1');
      } catch {
        /* ignore */
      }
    });
  }
</script>
