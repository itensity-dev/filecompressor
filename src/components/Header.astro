---
import { getDict, toolText } from '../i18n';
import { LOCALE_INFO, LOCALES, localePath, type Locale } from '../i18n/locales';
import { SITE_NAME } from '../site';
import { FORMAT_LABEL, findConversion, getTool, MATRIX_FROM, MATRIX_TO, TOOLS } from '../tools';
import Caret from './Caret.astro';
import Logo from './Logo.astro';

interface Props {
  locale: Locale;
  page: string;
}
const { locale, page } = Astro.props;
const dict = getDict(locale);
const compress = TOOLS.filter((t) => t.category === 'compress');
const imageConverter = getTool('image-converter')!;
const themes = [
  ['system', dict.nav.themeSystem],
  ['light', dict.nav.themeLight],
  ['dark', dict.nav.themeDark],
] as const;
---

<header class="site-header">
  <div class="container header-inner">
    <a class="logo" href={localePath(locale)}>
      <Logo />
      <span>{SITE_NAME}</span>
    </a>

    <nav class="main-nav" aria-label={dict.nav.allTools}>
      <details class="menu">
        <summary>{dict.nav.compress}<Caret /></summary>
        <div class="menu-panel">
          <ul class="menu-list">
            {
              compress.map((tool) => (
                <li>
                  <a href={localePath(locale, tool.id)} aria-current={tool.id === page ? 'page' : undefined}>
                    {toolText(dict, tool).name}
                  </a>
                </li>
              ))
            }
          </ul>
        </div>
      </details>

      <details class="menu">
        <summary>{dict.nav.convert}<Caret /></summary>
        <div class="menu-panel convert-menu">
          <ul class="convert-rows">
            {
              MATRIX_FROM.map((from) => (
                <li>
                  <span class="from">{FORMAT_LABEL[from]} →</span>
                  <span class="targets">
                    {MATRIX_TO.map((to) => {
                      const tool = findConversion(from, to);
                      return (
                        tool && (
                          <a
                            class="fmt-link"
                            href={localePath(locale, tool.id)}
                            aria-current={tool.id === page ? 'page' : undefined}
                            title={toolText(dict, tool).name}
                          >
                            {FORMAT_LABEL[to]}
                          </a>
                        )
                      );
                    })}
                  </span>
                </li>
              ))
            }
          </ul>
          <div class="menu-foot">
            <a href={localePath(locale, imageConverter.id)}>{toolText(dict, imageConverter).name}</a>
          </div>
        </div>
      </details>

      <a class="nav-link hide-md" href={localePath(locale, 'about')}>{dict.nav.about}</a>
    </nav>

    <div class="header-tools">
      <details class="menu menu-lang">
        <summary aria-label={dict.nav.language} title={dict.nav.language}>
          {locale}<Caret />
        </summary>
        <div class="menu-panel align-right">
          <ul class="menu-list">
            {
              LOCALES.map((l) => (
                <li>
                  <a
                    href={localePath(l, page)}
                    hreflang={LOCALE_INFO[l].hreflang}
                    lang={LOCALE_INFO[l].hreflang}
                    aria-current={l === locale ? 'true' : undefined}
                    data-lang-choice
                  >
                    {LOCALE_INFO[l].name}
                  </a>
                </li>
              ))
            }
          </ul>
        </div>
      </details>

      <details class="menu menu-theme">
        <summary class="icon-toggle" aria-label={dict.nav.theme} title={dict.nav.theme}>
          <svg class="theme-icon ti-system" width="18" height="18" viewBox="0 0 24 24" aria-hidden="true"><circle cx="12" cy="12" r="8.5" fill="none" stroke="currentColor" stroke-width="2"></circle><path d="M12 3.5a8.5 8.5 0 0 1 0 17z" fill="currentColor"></path></svg>
          <svg class="theme-icon ti-light" width="18" height="18" viewBox="0 0 24 24" aria-hidden="true"><circle cx="12" cy="12" r="4.5" fill="none" stroke="currentColor" stroke-width="2"></circle><path d="M12 2v2.5M12 19.5V22M2 12h2.5M19.5 12H22M4.9 4.9l1.8 1.8M17.3 17.3l1.8 1.8M4.9 19.1l1.8-1.8M17.3 6.7l1.8-1.8" stroke="currentColor" stroke-width="2" stroke-linecap="round"></path></svg>
          <svg class="theme-icon ti-dark" width="18" height="18" viewBox="0 0 24 24" aria-hidden="true"><path d="M20 14.5A8.5 8.5 0 0 1 9.5 4a8.5 8.5 0 1 0 10.5 10.5z" fill="none" stroke="currentColor" stroke-width="2" stroke-linejoin="round"></path></svg>
        </summary>
        <div class="menu-panel align-right">
          <ul class="menu-list">
            {
              themes.map(([value, label]) => (
                <li>
                  <button type="button" data-theme-choice={value} aria-pressed="false">
                    {label}
                  </button>
                </li>
              ))
            }
          </ul>
        </div>
      </details>
    </div>
  </div>
</header>

<script>
  // Dropdowns: close on outside click / Escape, keep only one open.
  const menus = Array.from(document.querySelectorAll<HTMLDetailsElement>('details.menu'));
  document.addEventListener('click', (e) => {
    for (const m of menus) if (m.open && !m.contains(e.target as Node)) m.open = false;
  });
  document.addEventListener('keydown', (e) => {
    if (e.key === 'Escape') for (const m of menus) m.open = false;
  });
  for (const m of menus) {
    m.addEventListener('toggle', () => {
      if (m.open) for (const o of menus) if (o !== m) o.open = false;
    });
  }

  for (const a of document.querySelectorAll('[data-lang-choice]')) {
    a.addEventListener('click', () => {
      try {
        localStorage.setItem('fc:lang-chosen', '1');
      } catch {
        /* storage blocked */
      }
    });
  }

  // Theme: "system" follows the OS; light/dark are remembered in this browser.
  const root = document.documentElement;
  const buttons = Array.from(document.querySelectorAll<HTMLButtonElement>('[data-theme-choice]'));
  const mark = (choice: string) => {
    for (const b of buttons) b.setAttribute('aria-pressed', String(b.dataset.themeChoice === choice));
  };
  mark(root.dataset.theme || 'system');
  for (const b of buttons) {
    b.addEventListener('click', () => {
      const choice = b.dataset.themeChoice!;
      if (choice === 'system') delete root.dataset.theme;
      else root.dataset.theme = choice;
      try {
        if (choice === 'system') localStorage.removeItem('fc:theme');
        else localStorage.setItem('fc:theme', choice);
      } catch {
        /* storage blocked: applies to this page only */
      }
      mark(choice);
      b.closest('details')?.removeAttribute('open');
    });
  }
</script>
