---
import { getDict, toolText } from '../i18n';
import { localePath, type Locale } from '../i18n/locales';
import { FORMAT_LABEL, type Tool } from '../tools';

interface Props {
  locale: Locale;
  tools: Tool[];
}
const { locale, tools } = Astro.props;
const dict = getDict(locale);
const badge = (t: Tool) =>
  t.to === 'same' ? 'IMG' : t.category === 'convert' ? FORMAT_LABEL[t.to] : FORMAT_LABEL[t.from[0]];
---

<ul class="cards">
  {
    tools.map((tool) => {
      const text = toolText(dict, tool);
      return (
        <li>
          <a class="card" href={localePath(locale, tool.id)}>
            <span class={`card-badge fmt-${tool.category === 'convert' ? tool.to : tool.from[0]}`}>{badge(tool)}</span>
            <span class="card-body">
              <span class="card-title">{text.name}</span>
              <span class="card-text">{text.card}</span>
            </span>
          </a>
        </li>
      );
    })
  }
</ul>
