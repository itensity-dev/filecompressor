---
// Suggests the visitor's own language (never redirects: crawlers and users
// always get the URL they asked for).
import { getDict } from '../i18n';
import { LOCALES, localePath, type Locale } from '../i18n/locales';

interface Props {
  locale: Locale;
  page: string;
}
const { locale, page } = Astro.props;
const alternates = Object.fromEntries(
  LOCALES.map((l) => [l, { href: localePath(l, page), ...getDict(l).langBanner }]),
);
---

<div class="lang-banner" hidden data-current={locale} data-alternates={JSON.stringify(alternates)}>
  <div class="container lang-banner-inner">
    <span class="lang-banner-text"></span>
    <a class="btn btn-small btn-primary lang-banner-go"></a>
    <button type="button" class="icon-btn lang-banner-close">✕</button>
  </div>
</div>

<script>
  const banner = document.querySelector<HTMLElement>('.lang-banner');
  try {
    if (banner && !localStorage.getItem('fc:lang-chosen')) {
      const current = banner.dataset.current!;
      const alts = JSON.parse(banner.dataset.alternates!) as Record<
        string,
        { href: string; text: string; action: string; dismiss: string }
      >;
      const preferred = navigator.languages
        .map((l) => l.toLowerCase().split('-')[0])
        .find((l) => l in alts);
      if (preferred && preferred !== current) {
        const alt = alts[preferred];
        banner.querySelector('.lang-banner-text')!.textContent = alt.text;
        const go = banner.querySelector<HTMLAnchorElement>('.lang-banner-go')!;
        go.textContent = alt.action;
        go.href = alt.href;
        go.lang = preferred;
        const close = banner.querySelector<HTMLButtonElement>('.lang-banner-close')!;
        close.setAttribute('aria-label', alt.dismiss);
        banner.lang = preferred;
        const remember = () => localStorage.setItem('fc:lang-chosen', '1');
        go.addEventListener('click', remember);
        close.addEventListener('click', () => {
          remember();
          banner.hidden = true;
        });
        banner.hidden = false;
      }
    }
  } catch {
    /* storage blocked: no banner */
  }
</script>
