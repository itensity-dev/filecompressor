---
import Features from '../../components/Features.astro';
import { fmt, getDict } from '../../i18n';
import { langParams, type Locale } from '../../i18n/locales';
import Base from '../../layouts/Base.astro';

export function getStaticPaths() {
  return langParams().map(({ lang, locale }) => ({ params: { lang }, props: { locale } }));
}

const { locale } = Astro.props as { locale: Locale };
const dict = getDict(locale);
---

<Base locale={locale} title={fmt(dict.meta.aboutTitle)} description={fmt(dict.meta.aboutDescription)} page="about">
  <section class="hero container">
    <h1>{fmt(dict.about.h1)}</h1>
  </section>
  <div class="container">
    {
      dict.about.sections.map((s) => (
        <section class="section split">
          <h2>{fmt(s.h)}</h2>
          <div class="body">
            <p>{fmt(s.p)}</p>
          </div>
        </section>
      ))
    }
    <Features locale={locale} />
  </div>
</Base>
