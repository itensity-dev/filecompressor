---
import Faq from '../../components/Faq.astro';
import Features from '../../components/Features.astro';
import Matrix from '../../components/Matrix.astro';
import PrivacyLine from '../../components/PrivacyLine.astro';
import ToolList from '../../components/ToolList.astro';
import { fmt, getDict, toolText } from '../../i18n';
import { langParams, localePath, LOCALE_INFO, type Locale } from '../../i18n/locales';
import Base from '../../layouts/Base.astro';
import { SITE_NAME } from '../../site';
import { FORMAT_LABEL, getTool, TOOLS, type Tool } from '../../tools';

export function getStaticPaths() {
  return langParams().map(({ lang, locale }) => ({ params: { lang }, props: { locale } }));
}

const { locale } = Astro.props as { locale: Locale };
const dict = getDict(locale);
const vars = { tool: SITE_NAME };
const faq = dict.faq.items.map((i) => ({ q: fmt(i.q, vars), a: fmt(i.a, vars) }));
const url = new URL(localePath(locale), Astro.site).href;
const imageConverter = getTool('image-converter')!;
// The most common jobs, one click from the homepage.
const quick = ['compress-pdf', 'compress-image', 'heic-to-jpg', 'jpg-to-pdf', 'pdf-to-jpg']
  .map((id) => getTool(id))
  .filter((t): t is Tool => !!t);
const formatsOf = (t: Tool) =>
  t.to === 'same' ? 'IMG' : t.to === t.from[0] ? FORMAT_LABEL[t.to] : `${FORMAT_LABEL[t.from[0]]}→${FORMAT_LABEL[t.to]}`;
const imageConverterText = toolText(dict, imageConverter);

const jsonLd = [
  {
    '@context': 'https://schema.org',
    '@type': 'WebSite',
    name: SITE_NAME,
    url,
    description: fmt(dict.meta.homeDescription),
    inLanguage: LOCALE_INFO[locale].hreflang,
  },
  {
    '@context': 'https://schema.org',
    '@type': 'WebApplication',
    name: SITE_NAME,
    url,
    applicationCategory: 'MultimediaApplication',
    operatingSystem: 'Any',
    isAccessibleForFree: true,
    offers: { '@type': 'Offer', price: '0', priceCurrency: 'USD' },
    featureList: dict.why.items.map((i) => i.title),
  },
  {
    '@context': 'https://schema.org',
    '@type': 'FAQPage',
    mainEntity: faq.map((i) => ({
      '@type': 'Question',
      name: i.q,
      acceptedAnswer: { '@type': 'Answer', text: i.a },
    })),
  },
];
---

<Base locale={locale} title={fmt(dict.meta.homeTitle)} description={fmt(dict.meta.homeDescription)} page="" jsonLd={jsonLd}>
  <section class="hero hero-home container">
    <div class="hero-grid">
      <div>
        <h1>{dict.home.h1}</h1>
        <p class="lead">{dict.home.subtitle}</p>
        <PrivacyLine locale={locale} />
      </div>
      <nav class="quick" aria-label={dict.nav.allTools}>
        <ul>
          {
            quick.map((tool) => (
              <li>
                <a href={localePath(locale, tool.id)}>
                  <span>{toolText(dict, tool).name}</span>
                  <span class="mono">{formatsOf(tool)}</span>
                  <span aria-hidden="true">→</span>
                </a>
              </li>
            ))
          }
        </ul>
      </nav>
    </div>
  </section>

  <div class="container">
    <section class="section" id="compress">
      <div class="section-head">
        <h2>{dict.home.compressTitle}</h2>
      </div>
      <ToolList locale={locale} tools={TOOLS.filter((t) => t.category === 'compress')} />
    </section>

    <section class="section" id="convert">
      <div class="section-head">
        <h2>{dict.home.convertTitle}</h2>
        <p>{dict.home.convertHint}</p>
      </div>
      <Matrix locale={locale} />
      <p class="matrix-note">
        <a href={localePath(locale, imageConverter.id)}>{imageConverterText.name} →</a>
        {' '}{imageConverterText.card}
      </p>
    </section>

    <Features locale={locale} />
    <Faq title={dict.faq.title} items={faq} />
  </div>
</Base>
