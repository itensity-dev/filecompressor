---
import '../styles/global.css';
import Footer from '../components/Footer.astro';
import Header from '../components/Header.astro';
import LangBanner from '../components/LangBanner.astro';
import { getDict } from '../i18n';
import { LOCALE_INFO, LOCALES, localePath, type Locale } from '../i18n/locales';
import { SITE_NAME, THEME_COLOR } from '../site';

interface Props {
  locale: Locale;
  title: string;
  description: string;
  /** Page key shared across languages: '' (home), a tool id, 'about'. */
  page: string;
  jsonLd?: object[];
  noindex?: boolean;
}

const { locale, title, description, page, jsonLd = [], noindex = false } = Astro.props;
const dict = getDict(locale);
const site = Astro.site!;
const abs = (path: string) => new URL(path, site).href.replace(/\/$/, '') || site.href;
const canonical = abs(localePath(locale, page));
const alternates = LOCALES.map((l) => ({ l, href: abs(localePath(l, page)) }));
const ogImage = new URL('/og.png', site).href;
---

<!doctype html>
<html lang={LOCALE_INFO[locale].hreflang} dir="ltr">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>{title}</title>
    <meta name="description" content={description} />
    {noindex && <meta name="robots" content="noindex" />}
    {
      !noindex && (
        <>
          <link rel="canonical" href={canonical} />
          {alternates.map(({ l, href }) => (
            <link rel="alternate" hreflang={LOCALE_INFO[l].hreflang} href={href} />
          ))}
          <link rel="alternate" hreflang="x-default" href={alternates[0].href} />
        </>
      )
    }
    <meta name="theme-color" content={THEME_COLOR} />
    <meta name="color-scheme" content="light dark" />
    <link rel="icon" href="/favicon.svg" type="image/svg+xml" />
    <link rel="icon" href="/favicon-32.png" sizes="32x32" type="image/png" />
    <link rel="apple-touch-icon" href="/apple-touch-icon.png" />
    <link rel="manifest" href="/manifest.webmanifest" />
    <meta property="og:type" content="website" />
    <meta property="og:site_name" content={SITE_NAME} />
    <meta property="og:title" content={title} />
    <meta property="og:description" content={description} />
    <meta property="og:url" content={canonical} />
    <meta property="og:image" content={ogImage} />
    <meta property="og:image:width" content="1200" />
    <meta property="og:image:height" content="630" />
    <meta property="og:locale" content={LOCALE_INFO[locale].og} />
    {
      LOCALES.filter((l) => l !== locale).map((l) => (
        <meta property="og:locale:alternate" content={LOCALE_INFO[l].og} />
      ))
    }
    <meta name="twitter:card" content="summary_large_image" />
    {jsonLd.map((data) => <script is:inline type="application/ld+json" set:html={JSON.stringify(data)} />)}
  </head>
  <body>
    <a class="skip-link" href="#main">{dict.nav.skip}</a>
    <LangBanner locale={locale} page={page} />
    <Header locale={locale} page={page} />
    <main id="main">
      <slot />
    </main>
    <Footer locale={locale} page={page} />
    <script>
      // Offline support: cache the app shell and codecs after first use.
      if (import.meta.env.PROD && 'serviceWorker' in navigator) {
        window.addEventListener('load', () => {
          navigator.serviceWorker.register('/sw.js').catch(() => {});
        });
      }
    </script>
  </body>
</html>
