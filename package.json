{
  "name": "filecompressor",
  "private": true,
  "type": "module",
  "version": "0.1.0",
  "description": "Free, private, in-browser file compressor and converter (PDF, JPG, PNG, WebP, AVIF, HEIC). Files never leave the device.",
  "license": "MIT",
  "engines": {
    "node": ">=22.12.0"
  },
  "scripts": {
    "assets": "node scripts/copy-pdfjs-assets.mjs",
    "dev": "npm run assets && astro dev",
    "build": "npm run assets && astro build",
    "preview": "astro preview",
    "check": "astro check",
    "test:e2e": "playwright test",
    "test": "npm run check && npm run build && npm run test:e2e"
  },
  "dependencies": {
    "@astrojs/preact": "^6.0.5",
    "@jsquash/avif": "^2.1.1",
    "@jsquash/jpeg": "^1.6.0",
    "@jsquash/oxipng": "^2.3.0",
    "@jsquash/png": "^3.1.1",
    "@jsquash/resize": "^2.1.1",
    "@jsquash/webp": "^1.5.0",
    "astro": "^7.3.5",
    "fflate": "^0.8.3",
    "heic-to": "^1.6.5",
    "pdf-lib": "^1.17.1",
    "pdfjs-dist": "^6.3.289",
    "preact": "^10.29.8"
  },
  "devDependencies": {
    "@astrojs/check": "^0.9.10",
    "@playwright/test": "~1.56.1",
    "@types/node": "^22.20.5",
    "typescript": "^5.9.3"
  }
}
