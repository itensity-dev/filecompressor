# Security headers for Cloudflare Pages / Netlify (same syntax on both).
# The page itself also carries a CSP <meta> tag generated by Astro with
# hashes of inline scripts; this header adds the directives that only work as
# a header and applies the network restrictions to web workers too.
# connect-src 'self' means the page and its workers cannot send data to any
# other server, even if a dependency were compromised.

/*
  Content-Security-Policy: connect-src 'self' blob: data:; frame-ancestors 'none'; object-src 'none'; base-uri 'self'; form-action 'none'
  X-Content-Type-Options: nosniff
  Referrer-Policy: strict-origin-when-cross-origin
  Permissions-Policy: camera=(), microphone=(), geolocation=(), payment=(), usb=(), interest-cohort=()
  Cross-Origin-Opener-Policy: same-origin
  Cross-Origin-Resource-Policy: same-origin
  Strict-Transport-Security: max-age=63072000; includeSubDomains; preload
  X-Frame-Options: DENY

# Hashed build assets never change: cache them forever.
/_astro/*
  Cache-Control: public, max-age=31536000, immutable

/pdfjs/*
  Cache-Control: public, max-age=2592000

/sw.js
  Cache-Control: no-cache
